# macOS
.DS_Store

# Editor / IDE
.idea
.cursor/
.vscode/
*.sw?
.tldr/
.serena/

# Node.js (transparent-ui server)
node_modules
logs
*.log
npm-debug.log*
dist/
artifacts/
handoffs/

# Rust
target/

# Swift build artifacts
apps/swift/.build/
apps/swift/.swiftpm/
apps/swift/*.app
apps/swift/Capacitor.app/
apps/swift/resource_bundle_accessor-*

# Claude local state and scratch working notes (not shared)
# Durable migration and audit artifacts belong under docs/plans/ and docs/audits/.
.claude/hud-status.json
.claude/settings.local.json
.claude/archive/
.claude/docs/audit/
.claude/explorations/
.claude/migration/

# Local planning / session notes
*.local.md
plan-*.md
apps/swift/plan-*.md
recover.md

# Local runtime env with secrets
scripts/dev/capacitor-ingest.local

# Git worktrees
.worktrees/
dist-guide

# Working state directories (runtime, pipeline, relay)
.capacitor/
.pipeline/
.relay/

# Formal verifier caches and reports
**/.verifier/facts/
**/.verifier/reports/
.verifier/.venv/
tests/verify/fixtures/*/.verifier/

# Python bytecode caches
__pycache__/
*.pyc
